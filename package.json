{
  "name": "ob-davi",
  "version": "0.1.0",
  "private": true,
  "description": "OB-DaVi — local-first open-source Data Visualizer by onBlank.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@obdavi/desktop",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
