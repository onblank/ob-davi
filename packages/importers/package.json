    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "apache-arrow": "21.2.0",
    "better-sqlite3": "13.0.3",
    "mysql2": "3.24.4",
    "mssql": "12.7.2",
    "papaparse": "5.7.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.5"
  }
}
